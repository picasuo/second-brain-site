---
interface Props {
  className?: string;
  command: string;
}

const { className, command } = Astro.props;
---

<p class:list={["terminal-command", className]}><span class="terminal-command-prompt">$</span> <span class="terminal-command-text">{command}</span></p>

<style is:global>
  .terminal-command {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
  }

  .terminal-command .terminal-command-prompt {
    color: var(--accent);
    font-weight: 700;
    font-size: clamp(0.85rem, 1.35vw, 0.92rem);
  }

  .terminal-command .terminal-command-text {
    color: inherit;
    font-size: 14.5px;
  }
</style>

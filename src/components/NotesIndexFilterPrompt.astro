---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="cmdline-row" data-notes-filter-prompt data-tags={JSON.stringify(tags)} aria-label="Notes Index Filter Prompt">
  <span class="prompt" aria-hidden="true">$</span>
  <span class="cmd-static" data-notes-filter-static-command>ls -la ./notes --sort=date | grep -i</span>
  <div class="cmdline-wrap">
    <div class="cmdline-box" id="cmd-box">
      <div class="cmdline-mirror" id="cmd-mirror"></div>
      <input
        class="cmd-input"
        id="cmd-input"
        data-notes-search
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="输入 # 联想标签，或输入关键词筛选笔记标题"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="suggest"
        aria-expanded="false"
        autofocus
      />
      <span class="cmdline-count" id="cmd-count"></span>
    </div>
    <div class="suggest" id="suggest" data-tag-suggestions role="listbox"></div>
  </div>
  <div class="cmd-hint">输入 <kbd>#</kbd> 联想标签 · <kbd>↑</kbd><kbd>↓</kbd> 选择 · <kbd>Tab</kbd>/<kbd>Enter</kbd> 确认 · <kbd>Esc</kbd> 取消 · 空格分隔多个条件，交集筛选</div>
</div>

<script>
  let clearNotesIndexFilterListeners = () => {};

  const initializeNotesIndexFilter = () => {
    clearNotesIndexFilterListeners();

    const prompt = document.querySelector<HTMLElement>("[data-notes-filter-prompt]");
    if (prompt === null) return;

    const cmdInput = document.querySelector<HTMLInputElement>("#cmd-input")!;
    const cmdMirror = document.querySelector<HTMLElement>("#cmd-mirror")!;
    const cmdBox = document.querySelector<HTMLElement>("#cmd-box")!;
    const cmdCount = document.querySelector<HTMLElement>("#cmd-count")!;
    const suggestBox = document.querySelector<HTMLElement>("#suggest")!;
    const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-note-row]"));
    const table = document.querySelector<HTMLElement>("[data-notes-table]");
    const noMatch = document.querySelector<HTMLElement>("[data-no-match]");

    const controller = new AbortController();
    clearNotesIndexFilterListeners = () => controller.abort();
    const normalize = (value: string) => value.normalize("NFKC").trim().toLocaleLowerCase();
    const allTagNames = (JSON.parse(prompt.dataset.tags ?? "[]") as string[]).map(normalize);
    let currentSuggestions: string[] = [];
    let activeIndex = 0;
    let currentTokenRange = { start: 0, end: 0 };

    const escapeHtml = (value: string) =>
      value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    function syncCmdScroll() {
      cmdMirror.scrollLeft = cmdInput.scrollLeft;
      const overflow = cmdInput.scrollWidth > cmdInput.clientWidth + 1;
      const maxScroll = cmdInput.scrollWidth - cmdInput.clientWidth;
      cmdBox.classList.toggle("overflowing", overflow);
      cmdBox.classList.toggle("can-scroll-left", cmdInput.scrollLeft > 1);
      cmdBox.classList.toggle("can-scroll-right", overflow && maxScroll - cmdInput.scrollLeft > 1);
      if (overflow) {
        cmdCount.textContent = `${[...cmdInput.value].length} 字符`;
        cmdCount.classList.add("show");
      } else {
        cmdCount.classList.remove("show");
      }
    }

    function getTokenAtCursor(value: string, cursor: number) {
      let start = cursor;
      let end = cursor;
      while (start > 0 && !/\s/u.test(value[start - 1])) start -= 1;
      while (end < value.length && !/\s/u.test(value[end])) end += 1;
      return { text: value.slice(start, end), start, end };
    }

    function renderMirror(value: string) {
      if (value === "") {
        cmdMirror.innerHTML = '<span class="ph">输入 # 联想标签，或输入关键词模糊搜索标题…</span>';
        return;
      }
      const parts = value.split(/(\s+)/u);
      cmdMirror.innerHTML = parts
        .map((part) => {
          if (/^\s+$/u.test(part)) return `<span class="tk-space">${escapeHtml(part)}</span>`;
          if (part.startsWith("#")) {
            const known = allTagNames.includes(normalize(part.slice(1)));
            return `<span class="tk-tag${known ? "" : " partial"}">${escapeHtml(part)}</span>`;
          }
          return `<span class="tk-text">${escapeHtml(part)}</span>`;
        })
        .join("");
    }

    function renderSuggestions() {
      suggestBox.innerHTML =
        currentSuggestions
          .map((tag, index) => {
            const count = rows.filter((row) => (JSON.parse(row.dataset.noteTags ?? "[]") as string[]).some((rowTag) => normalize(rowTag) === tag)).length;
            return `<div class="suggest-item${index === activeIndex ? " active" : ""}" data-tag="${escapeHtml(tag)}"><span class="tag"><span class="hash">#</span>${escapeHtml(tag)}</span><span class="count">${count} 篇</span></div>`;
          })
          .join("") || '<div class="suggest-empty">没有匹配的标签</div>';
    }

    function closeSuggestions() {
      suggestBox.classList.remove("open");
      cmdInput.setAttribute("aria-expanded", "false");
      currentSuggestions = [];
    }

    function openSuggestFor(token: string, start: number) {
      const prefix = normalize(token.slice(1));
      currentSuggestions = allTagNames.filter((tag) => tag.startsWith(prefix));
      activeIndex = 0;
      currentTokenRange = { start, end: start + token.length };
      if (currentSuggestions.length === 0) {
        closeSuggestions();
        return;
      }
      renderSuggestions();
      suggestBox.classList.add("open");
      cmdInput.setAttribute("aria-expanded", "true");
    }

    function updateSuggestions() {
      const { text, start } = getTokenAtCursor(cmdInput.value, cmdInput.selectionStart ?? 0);
      if (text.startsWith("#")) openSuggestFor(text, start);
      else closeSuggestions();
    }

    function applyFilters() {
      const tokens = cmdInput.value.trim().split(/\s+/u).filter(Boolean);
      const tagTokens = tokens.filter((token) => token.startsWith("#")).map((token) => normalize(token.slice(1))).filter(Boolean);
      const textTokens = tokens.filter((token) => !token.startsWith("#")).map(normalize);
      let visibleCount = 0;
      for (const row of rows) {
        const noteTags = JSON.parse(row.dataset.noteTags ?? "[]") as string[];
        const tagMatches = tagTokens.every((token) => noteTags.some((tag) => normalize(tag).startsWith(token)));
        const titleMatches = textTokens.every((token) => normalize(row.dataset.noteTitle ?? "").includes(token));
        const visible = tagMatches && titleMatches;
        row.closest("li")?.toggleAttribute("hidden", !visible);
        if (visible) visibleCount += 1;
      }
      table?.toggleAttribute("hidden", visibleCount === 0);
      noMatch?.toggleAttribute("hidden", visibleCount !== 0);
    }

    function handleInputChange() {
      renderMirror(cmdInput.value);
      updateSuggestions();
      applyFilters();
      requestAnimationFrame(syncCmdScroll);
    }

    function acceptSuggestion(tag: string) {
      if (tag === "") return;
      const before = cmdInput.value.slice(0, currentTokenRange.start);
      const after = cmdInput.value.slice(currentTokenRange.end).replace(/^\s+/u, "");
      const insertion = `#${tag} `;
      cmdInput.value = before + insertion + after;
      const cursor = (before + insertion).length;
      cmdInput.setSelectionRange(cursor, cursor);
      closeSuggestions();
      handleInputChange();
      cmdInput.focus();
    }

    cmdInput.addEventListener("input", handleInputChange, { signal: controller.signal });
    cmdInput.addEventListener("click", () => { updateSuggestions(); syncCmdScroll(); }, { signal: controller.signal });
    cmdInput.addEventListener("scroll", syncCmdScroll, { signal: controller.signal });
    cmdInput.addEventListener("focus", () => { cmdBox.classList.add("focused"); syncCmdScroll(); }, { signal: controller.signal });
    cmdInput.addEventListener("blur", () => { cmdBox.classList.remove("focused"); window.setTimeout(closeSuggestions, 120); }, { signal: controller.signal });
    cmdInput.addEventListener("keydown", (event) => {
      if (!suggestBox.classList.contains("open")) return;
      if (event.key === "ArrowDown") {
        event.preventDefault();
        activeIndex = (activeIndex + 1) % currentSuggestions.length;
        renderSuggestions();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        activeIndex = (activeIndex - 1 + currentSuggestions.length) % currentSuggestions.length;
        renderSuggestions();
      } else if (event.key === "Tab" || event.key === "Enter") {
        event.preventDefault();
        acceptSuggestion(currentSuggestions[activeIndex] ?? "");
      } else if (event.key === "Escape") {
        closeSuggestions();
      }
    }, { signal: controller.signal });
    cmdInput.addEventListener("keyup", (event) => {
      if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) requestAnimationFrame(syncCmdScroll);
    }, { signal: controller.signal });
    suggestBox.addEventListener("mousedown", (event) => {
      const item = (event.target as Element).closest<HTMLElement>(".suggest-item");
      if (item === null) return;
      event.preventDefault();
      acceptSuggestion(item.dataset.tag ?? "");
    }, { signal: controller.signal });
    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest(".cmdline-wrap")) closeSuggestions();
    }, { signal: controller.signal });
    window.addEventListener("resize", syncCmdScroll, { signal: controller.signal });
    renderMirror("");
    syncCmdScroll();
    cmdInput.focus();
  };

  document.addEventListener("astro:page-load", initializeNotesIndexFilter);
  initializeNotesIndexFilter();
</script>

<style is:global>
  .cmdline-row {
    --green: var(--accent);
    --green-bright: var(--accent-strong);
    --green-bg: var(--accent-wash);
    --green-bg-strong: var(--accent-wash-strong);
    --text: var(--ink);
    --text-dim: var(--muted);
    --text-dimmer: var(--muted-faint);
    --border: var(--rule);
    --border-soft: var(--rule-soft);
    --panel-2: var(--surface-soft);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 26px 0 8px 2px;
    position: relative;
    font-family: var(--font-mono);
  }
  .prompt { color: var(--green); font-weight: 700; font-size: clamp(0.85rem, 1.35vw, 0.92rem);}
  .cmdline-row .cmd-static { font-size: 14.5px; color: var(--text-dimmer); white-space: nowrap; }
  .cmdline-wrap { position: relative; flex: 1 1 240px; min-width: 180px; }
  .cmdline-box {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--panel-2);
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .cmdline-box.focused { border-color: var(--green); box-shadow: 0 0 0 3px var(--green-bg); }
  .cmdline-box::before, .cmdline-box::after {
    content: "";
    position: absolute;
    top: 1px;
    bottom: 1px;
    width: 20px;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity .12s ease;
  }
  .cmdline-box::before { left: 1px; border-radius: 7px 0 0 7px; background: linear-gradient(90deg, var(--panel-2) 25%, transparent); }
  .cmdline-box::after { right: 1px; border-radius: 0 7px 7px 0; background: linear-gradient(270deg, var(--panel-2) 25%, transparent); }
  .cmdline-box.can-scroll-left::before { opacity: 1; }
  .cmdline-box.can-scroll-right::after { opacity: 1; }
  .cmdline-box.overflowing .cmd-input,
  .cmdline-box.overflowing .cmdline-mirror { padding-right: 40px; }
  .cmdline-mirror {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 7px 10px;
    font: inherit;
    font-size: 13.5px;
    white-space: pre;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  .cmdline-mirror .ph { color: var(--text-dimmer); display: block; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmdline-mirror .tk-text { color: var(--text); }
  .cmdline-mirror .tk-space { white-space: pre; }
  .cmdline-mirror .tk-tag { color: var(--green-bright); background: var(--green-bg); border-radius: 4px; }
  .cmdline-mirror .tk-tag.partial { color: var(--text-dim); background: transparent; border-bottom: 1px dashed var(--text-dimmer); }
  .cmd-input {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    padding: 7px 10px;
    font: inherit;
    font-size: 13.5px;
    background: transparent;
    border: none;
    color: transparent;
    -webkit-text-fill-color: transparent;
    caret-color: var(--green);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cmd-input:focus { outline: none; }
  .cmd-input::-webkit-scrollbar { display: none; height: 0; }
  .cmd-input::selection {
    background: var(--green-bg-strong);
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .cmdline-count {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10.5px;
    color: var(--text-dimmer);
    background: var(--panel-2);
    padding: 1px 5px;
    border-radius: 4px;
    pointer-events: none;
    z-index: 4;
    opacity: 0;
    transition: opacity .12s ease;
    white-space: nowrap;
  }
  .cmdline-count.show { opacity: 1; }
  .suggest {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 230px;
    max-width: 320px;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 6px;
    box-shadow: 0 20px 40px -20px var(--effect-popover-shadow);
    z-index: 30;
    display: none;
  }
  .suggest.open { display: block; }
  .suggest-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 7px 9px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-dim);
    cursor: pointer;
  }
  .suggest-item .tag { color: var(--text); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .suggest-item .tag .hash { color: var(--green); margin-right: 1px; }
  .suggest-item .count { color: var(--text-dimmer); font-size: 11px; flex: none; }
  .suggest-item.active { background: var(--green-bg); }
  .suggest-item.active .tag, .suggest-item.active .tag .hash { color: var(--green-bright); }
  .suggest-empty { padding: 10px 9px; font-size: 12.5px; color: var(--text-dimmer); }
  .cmd-hint { flex-basis: 100%; font-size: 11.5px; color: var(--text-dimmer); margin: 2px 0 20px 2px; }
  .cmd-hint kbd {
    font-family: inherit;
    background: var(--panel-2);
    border: 1px solid var(--border-soft);
    border-radius: 3px;
    padding: 0 4px;
    color: var(--text-dim);
  }
  @media (max-width: 560px) {
    .cmdline-row .cmd-static { white-space: normal; }
    .cmdline-wrap { flex-basis: 100%; }
    .cmdline-mirror,
    .cmd-input { font-size: 16px; }
  }
</style>

---
import { ClientRouter } from "astro:transitions";
import TerminalShell from "./TerminalShell.astro";

interface Props {
  title: string;
  ariaLabel: string;
  windowTitle: string;
}

const { title, ariaLabel, windowTitle } = Astro.props;
---

<!doctype html transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <main>
      <TerminalShell ariaLabel={ariaLabel} windowTitle={windowTitle}>
        <slot />
        <slot name="footer" slot="footer" />
      </TerminalShell>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", sans-serif;
    --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", sans-serif;
    --font-mono: "SFMono-Regular", ui-monospace, Menlo, Consolas, "PingFang SC", monospace;
    --accent: #6fe3a0;
    --accent-strong: #a4f7c3;
    --accent-wash: rgba(111, 227, 160, 0.1);
    --accent-wash-strong: rgba(111, 227, 160, 0.17);
    --canvas: #090c0a;
    --canvas-dot: #10140f;
    --ink: #dbe6df;
    --muted: #7c8a82;
    --muted-strong: #9ba8a1;
    --muted-faint: #4d5951;
    --rule: #1d2620;
    --rule-soft: #151c17;
    --surface: #0c110d;
    --surface-soft: #0a0f0b;
  }

  * { box-sizing: border-box; }

  body {
    min-width: 20rem;
    margin: 0;
    color: var(--ink);
    background: var(--canvas);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  main {
    width: min(calc(100% - 2rem), 70rem);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  main:has(.terminal-shell) {
    width: 100%;
    height: 100dvh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  a {
    color: var(--accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  a:hover { color: var(--accent); }

  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 0.22rem;
  }

  .section-kicker,
  .note-metadata,
  .tag-list,
  .note-index time {
    font-family: var(--font-mono);
  }

  .section-kicker {
    margin: 0 0 1.25rem;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .home-introduction {
    display: grid;
    align-content: center;
    min-height: calc(100dvh - 8rem);
    max-width: 58rem;
    padding: 2rem 0;
  }

  .home-introduction h1,
  .note h1 {
    margin: 0;
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .home-introduction h1 {
    max-width: 16ch;
    font-size: clamp(2.7rem, 7vw, 4.75rem);
    line-height: 1.03;
  }

  .home-introduction > p:not(.section-kicker) {
    max-width: 43rem;
    margin: 2rem 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.85;
  }

  .primary-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--accent-strong);
    border-radius: 0.35rem;
    color: var(--surface);
    background: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .primary-link:hover { color: var(--surface); background: var(--accent); }
  .primary-link:active { transform: translateY(1px); }

  .notes-index { max-width: 52rem; }

  .note-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* .note-list > li { border-top: 1px solid var(--rule); } */
  .note-list > li:last-child { border-bottom: 1px solid var(--rule); }

  .note-list article { padding: 1.55rem 0 1.65rem; }
  .note-list h2 { margin: 0; font-family: ui-serif, Georgia, Cambria, serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; line-height: 1.2; }
  .note-list h2 a { color: var(--ink); text-decoration: none; }
  .note-list h2 a:hover { color: var(--accent-strong); text-decoration: underline; text-decoration-thickness: 0.08em; }

  .note-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: baseline;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 0.08rem 0.38rem;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--rule));
    border-radius: 0.25rem;
    color: var(--accent-strong);
    background: var(--accent-wash);
  }

  .note { max-width: 70rem; }
  .return-link { display: inline-block; margin-bottom: 3rem; font-size: 0.95rem; font-weight: 650; }
  .note-header { max-width: 50rem; margin-bottom: 2.5rem; }
  .note h1 { font-size: clamp(2.35rem, 6vw, 4.8rem); line-height: 1.08; }
  .note-header .note-metadata { margin-top: 1.2rem; }

  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    grid-template-areas: "content toc";
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .table-of-contents {
    grid-area: toc;
    position: sticky;
    top: 1.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .table-of-contents > strong { display: block; margin-bottom: 0.8rem; color: var(--muted); font-size: 0.74rem; letter-spacing: 0.08em; }
  .table-of-contents ol { display: grid; gap: 0.55rem; margin: 0; padding: 0; list-style: none; }
  .table-of-contents .depth-3 { padding-left: 0.8rem; }
  .table-of-contents a { color: var(--muted); text-decoration: none; }
  .table-of-contents a:hover { color: var(--accent-strong); text-decoration: underline; }

  .note-body { grid-area: content; min-width: 0; max-width: 66ch; color: var(--ink); font-family: var(--font-mono); font-size: clamp(0.94rem, 1.45vw, 1rem); line-height: 1.9; }
  .note-body > :first-child { margin-top: 0; }
  .note-body > :last-child { margin-bottom: 0; }
  .note-body p { margin: 0 0 1.15rem; }
  .note-body:has(.doc-section) > :not(.doc-section) { margin-left: 2.375rem; }
  .note-body ul, .note-body ol { margin: 1.1rem 0 1.25rem; padding-left: 1.4rem; }
  .note-body li + li { margin-top: 0.35rem; }
  .note-body h2, .note-body h3 { scroll-margin-top: 1.5rem; line-height: 1.35; }
  .note-body h2 { margin: 0 0 1.15rem; color: var(--ink); font-size: 1.1rem; font-weight: 700; }
  .note-body h3 { margin: 2.1rem 0 0.8rem; color: var(--accent-strong); font-size: 0.94rem; font-weight: 650; }
  .note-body .doc-section { position: relative; margin: 0 0 2.375rem; padding-left: 2.375rem; border-left: 1px solid var(--rule-soft); }
  .note-body .doc-section:last-child { margin-bottom: 0; border-left-color: transparent; }
  .note-body .doc-section .sec-no,
  .note-body .doc-section[data-section-number]::before {
    position: absolute;
    top: 0.125rem;
    left: -0.8125rem;
    padding: 0.125rem 0.25rem;
    color: var(--muted-faint);
    background: var(--surface);
    font-size: 0.6875rem;
    line-height: normal;
  }
  .note-body .doc-section[data-section-number]::before { content: attr(data-section-number); }
  .note-body blockquote { margin: 1.65rem 0; padding: 0.85rem 1rem; border-left: 2px solid var(--accent); border-radius: 0 0.45rem 0.45rem 0; color: var(--muted-strong); background: var(--accent-wash); font-size: 0.92em; }
  .note-body blockquote > :last-child { margin-bottom: 0; }
  .note-body hr { height: 1px; margin: 2.5rem 0; border: 0; background: var(--rule-soft); }
  .note-body code { padding: 0.12em 0.34em; border: 1px solid var(--rule-soft); border-radius: 0.22rem; color: var(--accent-strong); background: var(--surface-soft); font-family: var(--font-mono); font-size: 0.86em; }
  .note-body pre { overflow-x: auto; padding: 1rem 1.15rem; border: 1px solid var(--rule-soft); border-radius: 0.5rem; color: var(--ink); background: var(--surface-soft); line-height: 1.65; }
  .note-body pre code { padding: 0; background: transparent; color: inherit; }
  .note-body table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-family: var(--font-sans); font-size: 0.84em; }
  .note-body th, .note-body td { padding: 0.65rem 0.75rem; border: 1px solid var(--rule); text-align: left; }
  .note-body th { color: var(--accent-strong); background: var(--accent-wash); }
  .note-body img { display: block; max-width: 100%; height: auto; }

  @media (max-width: 48rem) {
    main { width: min(calc(100% - 2rem), 44rem); padding: 1.5rem 0 3.5rem; }
    .home-introduction { min-height: calc(100dvh - 5rem); }
    .note-layout { grid-template-columns: 1fr; grid-template-areas: "toc" "content"; gap: 2.5rem; }
    .table-of-contents { position: static; padding: 1rem; border: 1px solid var(--rule); border-radius: 0.35rem; }
    .return-link { margin-bottom: 2rem; }
  }

  .note-list h2 a { color: var(--ink); }

  .terminal-shell {
    position: relative;
    display: grid;
    width: 100vw;
    height: 100dvh;
    margin-left: calc(50% - 50vw);
    padding: clamp(1rem, 4vw, 4.5rem);
    overflow: hidden;
    background: var(--canvas);
    isolation: isolate;
  }

  .pixel-field,
  .pixel-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pixel-field {
    opacity: 0.52;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(111, 227, 160, 0.12) 1px, transparent 1.25px),
      radial-gradient(circle at 1px 1px, rgba(219, 230, 223, 0.06) 1px, transparent 1.3px);
    background-position: 0 0, 8px 8px;
    background-size: 16px 16px;
    mask-image: radial-gradient(ellipse 90% 110% at 0% 14%, #000 0 35%, transparent 73%);
  }

  .pixel-glow {
    background:
      radial-gradient(circle at 77% 55%, rgba(111, 227, 160, 0.08), transparent 23rem),
      linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.025) 56%, transparent 75%);
  }

  .terminal-window {
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: min(100%, 60rem);
    height: 100%;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 22% 76%, rgba(111, 227, 160, 0.025)),
      rgba(12, 17, 13, 0.86);
    box-shadow:
      0 2rem 6rem rgba(0, 0, 0, 0.58),
      0 0 0 1px rgba(0, 0, 0, 0.48),
      inset 0 1px rgba(255, 255, 255, 0.08),
      inset 0 -1px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(1.75rem) saturate(145%);
  }

  .terminal-window.has-terminal-footer { grid-template-rows: auto minmax(0, 1fr) auto; }

  .terminal-window.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 20;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    border-right: 0;
    border-left: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .terminal-window.is-miniature {
    z-index: 30;
    box-shadow:
      0 1.4rem 2.9rem -1rem rgba(0, 0, 0, 0.78),
      0 0 0 1px rgba(0, 0, 0, 0.48),
      inset 0 1px rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }

  .terminal-window.is-miniature .terminal-body,
  .terminal-window.is-miniature .terminal-footer { pointer-events: none; }

  .terminal-app-icon,
  .terminal-mini-target {
    position: fixed;
    z-index: 40;
  }

  .terminal-app-icon {
    top: clamp(1rem, 4vw, 2rem);
    left: clamp(1rem, 4vw, 2rem);
    width: 3.75rem;
    height: 4.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    filter: drop-shadow(0 .85rem 1rem rgba(0, 0, 0, .52));
    opacity: 0;
    pointer-events: none;
    transform: translateY(-.45rem) scale(.88);
    transition: opacity 180ms ease, transform 220ms cubic-bezier(.32,.72,0,1), filter 160ms ease;
  }

  .terminal-app-icon.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .terminal-app-icon:hover { filter: drop-shadow(0 1rem 1.35rem rgba(0, 0, 0, .66)); transform: translateY(-.16rem) scale(1.04); }
  .terminal-app-icon:active { transform: translateY(0) scale(.96); }
  .terminal-app-icon img { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; -webkit-user-drag: none; }

  .terminal-mini-target {
    bottom: clamp(1rem, 4vw, 2rem);
    left: clamp(1rem, 4vw, 2rem);
    width: clamp(10.5rem, 19vw, 13.5rem);
    height: clamp(6.75rem, 12vw, 8.6rem);
    pointer-events: none;
    visibility: hidden;
  }

  .terminal-titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.65rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--muted);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.012));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.04);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    user-select: none;
    touch-action: none;
  }

  .window-controls {
    display: flex;
    justify-self: start;
    width: max-content;
    gap: 0.42rem;
  }
  .window-control {
    position: relative;
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ed6257;
    box-shadow: inset 0 1px rgba(255,255,255,.25);
    cursor: pointer;
    transition: filter 120ms ease, transform 120ms ease, opacity 120ms ease;
  }

  .window-control-icon-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 100ms ease;
  }
  .window-control-icon {
    position: absolute;
    display: block;
    max-width: none;
    pointer-events: none;
  }
  .window-control-close .window-control-icon-frame { inset: 2px; width: auto; height: auto; transform: none; }
  .window-control-close .window-control-icon { inset: 0; width: 100%; height: 100%; }
  .window-control-minimize .window-control-icon-frame { width: 0.54rem; height: 0.1rem; }
  .window-control-minimize .window-control-icon { inset: 0; width: 100%; height: 100%; }
  .window-control-fullscreen .window-control-icon-frame { width: 0.56rem; height: 0.5644rem; }
  .window-control-fullscreen .window-control-icon-frame.window-control-icon-enter-fullscreen { width: 0.5rem; height: 0.5rem; }
  .window-control-icon-enter-fullscreen .window-control-icon {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .window-control-icon-exit-fullscreen .window-control-icon {
    top: 0;
    left: -6.01%;
    width: 112.02%;
    height: 112.03%;
  }
  .window-control-icon-exit-fullscreen { display: none; }
  .terminal-titlebar:hover .window-control:not(:disabled) .window-control-icon-frame,
  .window-controls:focus-within .window-control:not(:disabled) .window-control-icon-frame { opacity: 1; }
  .window-control:hover:not(:disabled) { filter: brightness(1.12); transform: scale(1.18); }
  .window-control:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  .window-control:disabled { cursor: not-allowed; opacity: .34; filter: grayscale(.52); }
  .window-control-minimize { background: #f1bd4d; }
  .window-control-fullscreen { background: #62c553; }
  .window-control-fullscreen.is-fullscreen .window-control-icon-enter-fullscreen { display: none; }
  .window-control-fullscreen.is-fullscreen .window-control-icon-exit-fullscreen { display: block; }
  .window-title { justify-self: center; }
  .window-spacer { min-width: 2.7rem; }

  .terminal-body { min-height: 0; padding: clamp(1.8rem, 3vw, 3.25rem); overflow-y: auto; overscroll-behavior: contain; }
  .terminal-footer { border-top: 1px solid var(--rule-soft); }
  .terminal-footer-link { display: block; padding: 1rem clamp(1.3rem, 3vw, 3.25rem); color: var(--muted-strong); font: 700 .8rem var(--font-mono); text-decoration: none; white-space: nowrap; transition: color 140ms ease, background-color 140ms ease; }
  .terminal-footer-link:hover { color: var(--accent-strong); background: var(--accent-wash); }
  .terminal-footer-link:active { background: var(--accent-wash-strong); }
  .terminal-hero { display: flex; gap: clamp(1rem, 3vw, 2rem); align-items: center; }
  .terminal-command { margin: 0; color: var(--ink); font-family: var(--font-mono); font-size: clamp(0.85rem, 1.35vw, 0.92rem); font-weight: 700; }
  .terminal-command span { color: var(--accent); }

  .terminal-info { display: grid; grid-template-columns: minmax(0, 1fr); gap: .72rem; margin: clamp(1rem, 1.6vw, 1.5rem) 0 0; padding-left: 2ch; font-family: var(--font-mono); }
  .terminal-info div { display: grid; grid-template-columns: minmax(6.6rem, 9rem) minmax(0, 1fr); gap: 1rem; align-items: baseline; }
  .terminal-info dt { color: var(--muted); font-size: 0.78rem; }
  .terminal-info dd { margin: 0; color: var(--ink); font-size: .78rem; line-height: 1.6; }
  .terminal-info dd a { color: var(--accent-strong); text-decoration: none; }
  .terminal-info dd a:hover { text-decoration: underline; }
  .terminal-info dd [aria-hidden="true"] { color: var(--accent); }

  .profile-links { margin-top: clamp(2.25rem, 4vw, 3.5rem); }
  .links-heading { margin-bottom: .8rem; }
  .profile-links ul { display: grid; gap: .18rem; margin: 0; padding: 0; list-style: none; }
  .profile-links a { display: inline-flex; align-items: center; gap: .7rem; min-height: 2.25rem; padding: .35rem .5rem; color: var(--muted-strong); font-family: var(--font-mono); font-size: clamp(.98rem, 2vw, 1.13rem); font-weight: 650; text-decoration: none; transition: color 140ms ease, background 140ms ease; }
  .profile-links a.is-selected { color: var(--accent-strong); background: var(--accent-wash); }
  .profile-links a:focus-visible { outline: none; }
  .link-marker { width: .72rem; color: var(--accent); opacity: 0; transform: translateX(-.2rem); transition: opacity 140ms ease, transform 140ms ease; }
  .profile-links a.is-selected .link-marker { opacity: 1; transform: translateX(0); }
  .link-label { transition: text-shadow 140ms ease; }
  .profile-links a.is-selected .link-label { text-shadow: 0 0 .8rem rgba(178,247,155,.18); }
  .terminal-status { display: flex; gap: .48rem; align-items: center; margin: clamp(2.8rem, 5vw, 4.2rem) 0 0; color: var(--muted); font: .75rem var(--font-mono); }
  .terminal-status span { width: .48rem; height: .48rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 .75rem rgba(178,247,155,.78); animation: status-pulse 2.2s ease-in-out infinite; }

  .notes-index { max-width: 64rem; }
  .notes-index > .terminal-command { margin-bottom: 1.6rem; }
  .notes-summary { display: grid; gap: .45rem; margin: 0 0 2.3rem; padding-left: 2ch; font: .8rem var(--font-mono); }
  .notes-summary div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; }
  .notes-summary dt { color: var(--muted); }
  .notes-summary dd { margin: 0; color: var(--ink); }
  .notes-table { border-top: 1px solid var(--rule-soft); font-family: var(--font-mono); }
  .notes-table-header, .note-row { display: grid; grid-template-columns: 96px minmax(0, 1fr) 270px; gap: 16px; align-items: center; }
  .notes-table-header { padding: 10px 10px; color: var(--muted-faint); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; }
  .note-list { display: block; margin: 0; padding: 0; list-style: none; }
  .note-row { position: relative; padding: 13px 10px; border-top: 1px solid var(--rule-soft); border-radius: 8px; color: var(--ink); text-decoration: none; transition: background .12s ease; }
  .note-row::before { position: absolute; top: 8px; bottom: 8px; left: 0; width: 2px; border-radius: 2px; background: transparent; content: ""; }
  .note-row:hover, .note-row:focus-visible { background: var(--accent-wash); }
  .note-row:hover::before, .note-row:focus-visible::before { background: var(--accent); }
  .note-row:hover .note-row-title, .note-row:focus-visible .note-row-title { color: var(--accent-strong); }
  .note-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .note-row:active { background: var(--accent-wash-strong); }
  .note-row time { color: var(--muted-faint); font-size: 12.5px; }
  .note-row-name { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .note-row-permission { flex: none; color: var(--muted-faint); font-size: 11px; }

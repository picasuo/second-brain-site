---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", sans-serif;
    --accent: #92dd7a;
    --accent-strong: #b2f79b;
    --canvas: #101110;
    --ink: #f2f4ee;
    --muted: #a6aaa1;
    --rule: #343832;
    --surface: #1a1c1a;
  }

  * { box-sizing: border-box; }

  body {
    min-width: 20rem;
    margin: 0;
    color: var(--ink);
    background: var(--canvas);
    text-rendering: optimizeLegibility;
  }

  main {
    width: min(calc(100% - 2rem), 70rem);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  main:has(.terminal-shell) {
    width: 100%;
    height: 100dvh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  a {
    color: var(--accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  a:hover { color: var(--accent); }

  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 0.22rem;
  }

  .section-kicker,
  .note-metadata,
  .tag-list,
  .note-index time {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .section-kicker {
    margin: 0 0 1.25rem;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .home-introduction {
    display: grid;
    align-content: center;
    min-height: calc(100dvh - 8rem);
    max-width: 58rem;
    padding: 2rem 0;
  }

  .home-introduction h1,
  .notes-index h1,
  .note h1 {
    margin: 0;
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .home-introduction h1 {
    max-width: 16ch;
    font-size: clamp(2.7rem, 7vw, 4.75rem);
    line-height: 1.03;
  }

  .home-introduction > p:not(.section-kicker) {
    max-width: 43rem;
    margin: 2rem 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.85;
  }

  .primary-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--accent-strong);
    border-radius: 0.35rem;
    color: var(--surface);
    background: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .primary-link:hover { color: var(--surface); background: var(--accent); }
  .primary-link:active { transform: translateY(1px); }

  .notes-index { max-width: 52rem; }
  .notes-index h1 { font-size: clamp(2.3rem, 5vw, 4.25rem); line-height: 1.08; }
  .notes-index > p { max-width: 38rem; margin: 1.25rem 0 3.5rem; color: var(--muted); line-height: 1.75; }

  .note-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note-list > li { border-top: 1px solid var(--rule); }
  .note-list > li:last-child { border-bottom: 1px solid var(--rule); }

  .note-list article { padding: 1.55rem 0 1.65rem; }
  .note-list h2 { margin: 0; font-family: ui-serif, Georgia, Cambria, serif; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; line-height: 1.2; }
  .note-list h2 a { color: var(--ink); text-decoration: none; }
  .note-list h2 a:hover { color: var(--accent-strong); text-decoration: underline; text-decoration-thickness: 0.08em; }

  .note-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: baseline;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 0.08rem 0.38rem;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    color: var(--muted);
  }

  .note { max-width: 70rem; }
  .return-link { display: inline-block; margin-bottom: 3rem; font-size: 0.95rem; font-weight: 650; }
  .note-header { max-width: 50rem; margin-bottom: 2.5rem; }
  .note h1 { font-size: clamp(2.35rem, 6vw, 4.8rem); line-height: 1.08; }
  .note-header .note-metadata { margin-top: 1.2rem; }

  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    grid-template-areas: "content toc";
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .table-of-contents {
    grid-area: toc;
    position: sticky;
    top: 1.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .table-of-contents > strong { display: block; margin-bottom: 0.8rem; color: var(--muted); font-size: 0.74rem; letter-spacing: 0.08em; }
  .table-of-contents ol { display: grid; gap: 0.55rem; margin: 0; padding: 0; list-style: none; }
  .table-of-contents .depth-3 { padding-left: 0.8rem; }
  .table-of-contents a { color: var(--muted); text-decoration: none; }
  .table-of-contents a:hover { color: var(--accent-strong); text-decoration: underline; }

  .note-body { grid-area: content; min-width: 0; font-family: ui-serif, Georgia, Cambria, serif; font-size: clamp(1.06rem, 1.8vw, 1.2rem); line-height: 1.85; }
  .note-body > :first-child { margin-top: 0; }
  .note-body > :last-child { margin-bottom: 0; }
  .note-body h2, .note-body h3 { margin-top: 2.9em; scroll-margin-top: 1.5rem; line-height: 1.2; }
  .note-body h2 { font-size: 1.65em; }
  .note-body h3 { font-size: 1.28em; }
  .note-body blockquote { margin: 1.8rem 0; padding: 0.25rem 0 0.25rem 1.15rem; border-left: 0.2rem solid var(--accent); color: var(--muted); }
  .note-body hr { height: 1px; margin: 2.5rem 0; border: 0; background: var(--rule); }
  .note-body code { padding: 0.1em 0.3em; border-radius: 0.18rem; background: color-mix(in srgb, var(--accent) 10%, transparent); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.84em; }
  .note-body pre { overflow-x: auto; padding: 1rem 1.15rem; border-radius: 0.35rem; color: #e8f1f5; background: #080908; line-height: 1.6; }
  .note-body pre code { padding: 0; background: transparent; color: inherit; }
  .note-body table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.82em; }
  .note-body th, .note-body td { padding: 0.65rem 0.75rem; border: 1px solid var(--rule); text-align: left; }
  .note-body th { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .note-body img { display: block; max-width: 100%; height: auto; }

  @media (max-width: 48rem) {
    main { width: min(calc(100% - 2rem), 44rem); padding: 1.5rem 0 3.5rem; }
    .home-introduction { min-height: calc(100dvh - 5rem); }
    .note-layout { grid-template-columns: 1fr; grid-template-areas: "toc" "content"; gap: 2.5rem; }
    .table-of-contents { position: static; padding: 1rem; border: 1px solid var(--rule); border-radius: 0.35rem; }
    .return-link { margin-bottom: 2rem; }
  }

  .note-list h2 a { color: var(--ink); }

  .terminal-shell {
    position: relative;
    display: grid;
    width: 100vw;
    height: 100dvh;
    margin-left: calc(50% - 50vw);
    padding: clamp(1rem, 4vw, 4.5rem);
    overflow: hidden;
    background: #0e100e;
    isolation: isolate;
  }

  .pixel-field,
  .pixel-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pixel-field {
    opacity: 0.52;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(201, 219, 191, 0.3) 1px, transparent 1.25px),
      radial-gradient(circle at 1px 1px, rgba(201, 219, 191, 0.12) 1px, transparent 1.3px);
    background-position: 0 0, 8px 8px;
    background-size: 16px 16px;
    mask-image: radial-gradient(ellipse 90% 110% at 0% 14%, #000 0 35%, transparent 73%);
  }

  .pixel-glow {
    background:
      radial-gradient(circle at 77% 55%, rgba(169, 233, 141, 0.1), transparent 23rem),
      linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.035) 56%, transparent 75%);
  }

  .terminal-window {
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: min(100%, 70rem);
    height: 100%;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.07), transparent 22% 76%, rgba(178, 247, 155, 0.035)),
      rgba(4, 6, 5, 0.78);
    box-shadow:
      0 2rem 6rem rgba(0, 0, 0, 0.58),
      0 0 0 1px rgba(0, 0, 0, 0.48),
      inset 0 1px rgba(255, 255, 255, 0.16),
      inset 0 -1px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(1.75rem) saturate(145%);
    animation: terminal-enter 700ms cubic-bezier(.2,.8,.2,1) both;
  }

  .terminal-window.has-terminal-footer { grid-template-rows: auto minmax(0, 1fr) auto; }

  .terminal-titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.65rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    color: #afb1ac;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.025));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.08);
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .window-controls { display: flex; gap: 0.52rem; }
  .window-controls i { width: 0.78rem; height: 0.78rem; border-radius: 50%; background: #ed6257; box-shadow: inset 0 1px rgba(255,255,255,.25); }
  .window-controls i:nth-child(2) { background: #f1bd4d; }
  .window-controls i:nth-child(3) { background: #62c553; }
  .window-title { justify-self: center; }
  .window-spacer { min-width: 2.7rem; }

  .terminal-body { min-height: 0; padding: clamp(1.8rem, 3vw, 3.25rem); overflow-y: auto; overscroll-behavior: contain; }
  .terminal-footer { border-top: 1px solid rgba(255, 255, 255, 0.13); }
  .terminal-hero { display: flex; gap: clamp(1rem, 3vw, 2rem); align-items: center; }
  .terminal-command { margin: 0; color: #e7e9e2; font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; font-size: clamp(0.8rem, 1.6vw, 1rem); font-weight: 700; }
  .terminal-command span { color: var(--accent); }

  .terminal-info { display: grid; grid-template-columns: minmax(0, 1fr); gap: .72rem; margin: clamp(1rem, 1.6vw, 1.5rem) 0 0; padding-left: 2ch; font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; }
  .terminal-info div { display: grid; grid-template-columns: minmax(6.6rem, 9rem) minmax(0, 1fr); gap: 1rem; align-items: baseline; }
  .terminal-info dt { color: #898e86; font-size: 0.78rem; }
  .terminal-info dd { margin: 0; color: #f0f2eb; font-size: .78rem; line-height: 1.6; }
  .terminal-info dd a { color: var(--accent-strong); text-decoration: none; }
  .terminal-info dd a:hover { text-decoration: underline; }
  .terminal-info dd [aria-hidden="true"] { color: var(--accent); }

  .profile-links { margin-top: clamp(2.25rem, 4vw, 3.5rem); }
  .links-heading { margin-bottom: .8rem; }
  .profile-links ul { display: grid; gap: .18rem; margin: 0; padding: 0; list-style: none; }
  .profile-links a { display: inline-flex; align-items: center; gap: .7rem; min-height: 2.25rem; padding: .35rem .5rem; color: #a9aea5; font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; font-size: clamp(.98rem, 2vw, 1.13rem); font-weight: 650; text-decoration: none; transition: color 140ms ease, background 140ms ease; }
  .profile-links a.is-selected { color: var(--accent-strong); background: rgba(178,247,155,.07); }
  .profile-links a:focus-visible { outline: none; }
  .link-marker { width: .72rem; color: var(--accent); opacity: 0; transform: translateX(-.2rem); transition: opacity 140ms ease, transform 140ms ease; }
  .profile-links a.is-selected .link-marker { opacity: 1; transform: translateX(0); }
  .link-label { transition: text-shadow 140ms ease; }
  .profile-links a.is-selected .link-label { text-shadow: 0 0 .8rem rgba(178,247,155,.18); }
  .terminal-status { display: flex; gap: .48rem; align-items: center; margin: clamp(2.8rem, 5vw, 4.2rem) 0 0; color: #9da399; font: .75rem ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; }
  .terminal-status span { width: .48rem; height: .48rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 .75rem rgba(178,247,155,.78); animation: status-pulse 2.2s ease-in-out infinite; }

  @keyframes terminal-enter { from { opacity: 0; transform: translateY(1.5rem) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes status-pulse { 50% { opacity: .4; box-shadow: 0 0 .2rem rgba(178,247,155,.3); } }

  @media (max-width: 43rem) {
    .terminal-shell { padding: clamp(1.5rem, 4dvh, 3rem) .75rem; }
    .terminal-window { border-radius: .75rem; }
    .terminal-titlebar { min-height: 2.5rem; padding: 0 .85rem; }
    .terminal-body { padding: 2.15rem 1.3rem; }
    .terminal-info { gap: .72rem; }
    .terminal-info div { grid-template-columns: 6.15rem minmax(0, 1fr); gap: .55rem; }
    .profile-links { margin-top: 3.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-window, .terminal-status span { animation: none; }
    .profile-links a, .link-marker, .link-label { transition: none; }
  }
</style>

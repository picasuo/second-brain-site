---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: ui-serif, Georgia, serif; }
  body { margin: 0; color: #1d2329; background: #fafaf7; }
  main { width: min(100% - 2rem, 44rem); margin: 0 auto; padding: 4rem 0; }
  a { color: #075985; }
  article { font-size: 1.125rem; line-height: 1.7; }
</style>

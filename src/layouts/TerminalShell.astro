---
import terminalAppIcon from "../assets/terminal-app-icon.png";
// import terminalAppIcon from "../assets/Ghostty_Light__Full__-_macOS_27-959496687d_1024x1024x32.png";
import closeIcon from "../assets/window-controls/close.svg";
import exitFullscreenIcon from "../assets/window-controls/exit-fullscreen.svg";
import fullscreenIcon from "../assets/window-controls/fullscreen.svg";
import minimizeIcon from "../assets/window-controls/minimize.svg";

interface Props {
  ariaLabel: string;
  windowTitle: string;
}

const { ariaLabel, windowTitle } = Astro.props;
const hasFooter = Astro.slots.has("footer");
---

<section class="terminal-shell" aria-label={ariaLabel} transition:name="terminal-shell" transition:animate="none">
  <div class="pixel-field" aria-hidden="true"></div>
  <div class="pixel-glow" aria-hidden="true"></div>

  <button class="terminal-app-icon" type="button" aria-label="恢复终端窗口" aria-hidden="true" tabindex="-1">
    <img src={terminalAppIcon.src} alt="" draggable="false" />
  </button>
  <div class="terminal-mini-target" aria-hidden="true"></div>

  <div class:list={["terminal-window", { "has-terminal-footer": hasFooter }]} transition:name="terminal-window" transition:animate="none">
    <div class="terminal-titlebar" transition:name="terminal-titlebar" transition:animate="none">
      <span class="window-controls" role="group" aria-label="窗口控件">
        <button class="window-control window-control-close" type="button" aria-label="收起为应用图标" title="收起为应用图标">
          <span class="window-control-icon-frame">
            <img class="window-control-icon" src={closeIcon.src} alt="" />
          </span>
        </button>
        <button class="window-control window-control-minimize" type="button" aria-label="缩放为悬浮小窗" title="缩放为悬浮小窗">
          <span class="window-control-icon-frame">
            <img class="window-control-icon" src={minimizeIcon.src} alt="" />
          </span>
        </button>
        <button class="window-control window-control-fullscreen" type="button" aria-label="进入全屏" title="进入全屏">
          <span class="window-control-icon-frame window-control-icon-enter-fullscreen">
            <img class="window-control-icon" src={fullscreenIcon.src} alt="" />
          </span>
          <span class="window-control-icon-frame window-control-icon-exit-fullscreen">
            <img class="window-control-icon" src={exitFullscreenIcon.src} alt="" />
          </span>
        </button>
      </span>
      <span class="window-title">{windowTitle}</span>
      <span class="window-spacer"></span>
    </div>

    <div class="terminal-body" transition:name="terminal-body" transition:animate="fade"><slot /></div>

    {hasFooter && <footer class="terminal-footer" transition:animate="fade"><slot name="footer" /></footer>}
  </div>
</section>

<script>
  type WindowForm = "windowed" | "fullscreen" | "floating-miniature";

  interface WindowPosition {
    left: number;
    top: number;
    width: number;
    height: number;
  }

  interface WindowPresentation {
    form: WindowForm;
    iconified: boolean;
    position: WindowPosition | null;
  }

  const presentation: WindowPresentation = {
    form: document.documentElement.dataset.terminalInitialForm === "fullscreen" ? "fullscreen" : "windowed",
    iconified: false,
    position: null,
  };

  const transitionEase = "cubic-bezier(.32,.72,0,1)";
  let cleanupActiveWindow: (() => void) | undefined;

  function motionDuration(duration: number) {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : duration;
  }

  function waitForAnimation(element: HTMLElement, duration: number, complete: () => void) {
    let settled = false;
    let timer: number | undefined;

    const onTransitionEnd = (event: TransitionEvent) => {
      if (event.target !== element || event.propertyName !== "transform") return;
      settle();
    };

    const settle = () => {
      if (settled) return;
      settled = true;
      if (timer !== undefined) window.clearTimeout(timer);
      element.removeEventListener("transitionend", onTransitionEnd);
      complete();
    };

    if (duration === 0) {
      settle();
      return;
    }

    timer = window.setTimeout(settle, duration + 40);
    element.addEventListener("transitionend", onTransitionEnd);
  }

  function initializeTerminalWindow() {
    cleanupActiveWindow?.();

    const shell = document.querySelector<HTMLElement>(".terminal-shell");
    if (!shell) return;

    const terminalWindow = shell.querySelector<HTMLElement>(".terminal-window")!;
    const titlebar = shell.querySelector<HTMLElement>(".terminal-titlebar")!;
    const appIcon = shell.querySelector<HTMLButtonElement>(".terminal-app-icon")!;
    const miniTarget = shell.querySelector<HTMLElement>(".terminal-mini-target")!;
    const closeControl = shell.querySelector<HTMLButtonElement>(".window-control-close")!;
    const minimizeControl = shell.querySelector<HTMLButtonElement>(".window-control-minimize")!;
    const fullscreenControl = shell.querySelector<HTMLButtonElement>(".window-control-fullscreen")!;

    let drag:
      | { pointerId: number; startX: number; startY: number; origin: WindowPosition; moved: boolean }
      | undefined;
    let touchTap: { pointerId: number; startX: number; startY: number; moved: boolean } | undefined;
    let previousTitlebarTap: { timestamp: number; x: number; y: number } | undefined;
    let isAnimating = false;
    const titlebarTapMovement = 3;
    const titlebarDoubleTapInterval = 320;
    const titlebarDoubleTapDistance = 24;

    function syncControls() {
      const canMinimize = presentation.form === "windowed" && !presentation.iconified;
      minimizeControl.disabled = !canMinimize;
      minimizeControl.setAttribute("aria-label", canMinimize ? "缩放为悬浮小窗" : "全屏时不能缩放为悬浮小窗");
      fullscreenControl.classList.toggle("is-fullscreen", presentation.form === "fullscreen");
      fullscreenControl.setAttribute("aria-label", presentation.form === "fullscreen" ? "退出全屏" : "进入全屏");
      fullscreenControl.title = presentation.form === "fullscreen" ? "退出全屏" : "进入全屏";
      appIcon.classList.toggle("is-visible", presentation.iconified);
      appIcon.setAttribute("aria-hidden", String(!presentation.iconified));
      appIcon.tabIndex = presentation.iconified ? 0 : -1;
    }

    function clearInlineBox() {
      terminalWindow.style.position = "";
      terminalWindow.style.inset = "";
      terminalWindow.style.margin = "";
      terminalWindow.style.left = "";
      terminalWindow.style.top = "";
      terminalWindow.style.bottom = "";
      terminalWindow.style.width = "";
      terminalWindow.style.height = "";
      terminalWindow.style.zIndex = "";
      terminalWindow.style.opacity = "";
      terminalWindow.style.pointerEvents = "";
      terminalWindow.style.transform = "";
      terminalWindow.style.transformOrigin = "";
      terminalWindow.style.transition = "";
    }

    function clampPosition(position: WindowPosition): WindowPosition {
      const titlebarHeight = titlebar.getBoundingClientRect().height;
      const visibleWidth = Math.min(position.width, 72);
      return {
        ...position,
        left: Math.min(Math.max(position.left, -position.width + visibleWidth), window.innerWidth - visibleWidth),
        top: Math.min(Math.max(position.top, 0), Math.max(0, window.innerHeight - titlebarHeight)),
      };
    }

    function applyWindowedLayout() {
      terminalWindow.classList.remove("is-fullscreen", "is-miniature", "is-iconified");
      clearInlineBox();
      if (!presentation.position) return;

      presentation.position = clampPosition(presentation.position);
      terminalWindow.style.position = "fixed";
      terminalWindow.style.margin = "0";
      terminalWindow.style.left = `${presentation.position.left}px`;
      terminalWindow.style.top = `${presentation.position.top}px`;
      terminalWindow.style.width = `${presentation.position.width}px`;
      terminalWindow.style.height = `${presentation.position.height}px`;
      terminalWindow.style.zIndex = "20";
    }

    function applyFullscreenLayout() {
      clearInlineBox();
      terminalWindow.classList.remove("is-miniature", "is-iconified");
      terminalWindow.classList.add("is-fullscreen");
    }

    function applyFormLayout() {
      if (presentation.form === "fullscreen") applyFullscreenLayout();
      else applyWindowedLayout();
      document.documentElement.removeAttribute("data-terminal-initial-form");
      syncControls();
    }

    function freezeAt(rect: DOMRect) {
      terminalWindow.classList.remove("is-fullscreen", "is-miniature", "is-iconified");
      terminalWindow.style.transition = "none";
      terminalWindow.style.position = "fixed";
      terminalWindow.style.inset = "auto";
      terminalWindow.style.margin = "0";
      terminalWindow.style.left = `${rect.left}px`;
      terminalWindow.style.top = `${rect.top}px`;
      terminalWindow.style.bottom = "auto";
      terminalWindow.style.width = `${rect.width}px`;
      terminalWindow.style.height = `${rect.height}px`;
      terminalWindow.style.zIndex = "30";
      terminalWindow.style.opacity = "";
      terminalWindow.style.pointerEvents = "";
      terminalWindow.style.transformOrigin = "0 0";
      terminalWindow.style.transform = "translate(0, 0) scale(1, 1)";
      void terminalWindow.offsetWidth;
    }

    function transformTo(target: DOMRect, duration: number, complete: () => void) {
      const start = terminalWindow.getBoundingClientRect();
      const translateX = target.left - start.left;
      const translateY = target.top - start.top;
      const scaleX = target.width / start.width;
      const scaleY = target.height / start.height;
      const actualDuration = motionDuration(duration);

      if (actualDuration === 0) {
        terminalWindow.style.transition = "none";
        terminalWindow.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scaleX}, ${scaleY})`;
        complete();
        return;
      }

      terminalWindow.style.transition = `transform ${actualDuration}ms ${transitionEase}`;
      requestAnimationFrame(() => {
        terminalWindow.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scaleX}, ${scaleY})`;
      });
      waitForAnimation(terminalWindow, actualDuration, complete);
    }

    function applyMiniatureWithoutAnimation() {
      applyWindowedLayout();
      const start = terminalWindow.getBoundingClientRect();
      freezeAt(start);
      const target = miniTarget.getBoundingClientRect();
      terminalWindow.classList.add("is-miniature");
      terminalWindow.style.transform = `translate(${target.left - start.left}px, ${target.top - start.top}px) scale(${target.width / start.width}, ${target.height / start.height})`;
      syncControls();
    }

    function minimize() {
      if (isAnimating || presentation.form !== "windowed" || presentation.iconified) return;
      const start = terminalWindow.getBoundingClientRect();
      freezeAt(start);
      presentation.form = "floating-miniature";
      isAnimating = true;
      terminalWindow.classList.add("is-miniature");
      syncControls();
      transformTo(miniTarget.getBoundingClientRect(), 460, () => {
        terminalWindow.style.transition = "";
        isAnimating = false;
      });
    }

    function restoreFromMiniature() {
      if (isAnimating || presentation.form !== "floating-miniature") return;
      presentation.form = "windowed";
      isAnimating = true;
      terminalWindow.classList.remove("is-miniature");
      syncControls();
      const duration = motionDuration(420);
      if (duration === 0) {
        terminalWindow.style.transform = "translate(0, 0) scale(1, 1)";
        isAnimating = false;
        applyFormLayout();
        return;
      }

      terminalWindow.style.transition = `transform ${duration}ms ${transitionEase}`;
      requestAnimationFrame(() => {
        terminalWindow.style.transform = "translate(0, 0) scale(1, 1)";
      });
      waitForAnimation(terminalWindow, duration, () => {
        isAnimating = false;
        applyFormLayout();
      });
    }

    function applyIconifiedWithoutAnimation() {
      applyFormLayout();
      const start = terminalWindow.getBoundingClientRect();
      freezeAt(start);
      const target = appIcon.getBoundingClientRect();
      terminalWindow.classList.add("is-iconified");
      terminalWindow.style.transform = `translate(${target.left - start.left}px, ${target.top - start.top}px) scale(${target.width / start.width}, ${target.height / start.height})`;
      terminalWindow.style.opacity = "0";
      terminalWindow.style.pointerEvents = "none";
      syncControls();
    }

    function iconify() {
      if (isAnimating || presentation.iconified || presentation.form === "floating-miniature") return;
      const start = terminalWindow.getBoundingClientRect();
      freezeAt(start);
      presentation.iconified = true;
      isAnimating = true;
      terminalWindow.classList.add("is-iconified");
      syncControls();
      transformTo(appIcon.getBoundingClientRect(), 380, () => {
        terminalWindow.style.transition = "";
        terminalWindow.style.opacity = "0";
        terminalWindow.style.pointerEvents = "none";
        isAnimating = false;
      });
    }

    function restoreFromIcon() {
      if (isAnimating || !presentation.iconified) return;
      presentation.iconified = false;
      isAnimating = true;
      terminalWindow.style.opacity = "";
      terminalWindow.style.pointerEvents = "";
      terminalWindow.classList.remove("is-iconified");
      syncControls();
      const duration = motionDuration(380);
      if (duration === 0) {
        terminalWindow.style.transform = "translate(0, 0) scale(1, 1)";
        isAnimating = false;
        applyFormLayout();
        return;
      }

      terminalWindow.style.transition = `transform ${duration}ms ${transitionEase}`;
      requestAnimationFrame(() => {
        terminalWindow.style.transform = "translate(0, 0) scale(1, 1)";
      });
      waitForAnimation(terminalWindow, duration, () => {
        isAnimating = false;
        applyFormLayout();
      });
    }

    function toggleFullscreen() {
      if (isAnimating || presentation.iconified || presentation.form === "floating-miniature") return;
      presentation.form = presentation.form === "windowed" ? "fullscreen" : "windowed";
      applyFormLayout();
    }

    function pointerDown(event: PointerEvent) {
      if (event.button !== 0 || presentation.iconified || presentation.form === "floating-miniature") return;
      if (event.target instanceof Element && event.target.closest("button, a, input, select, textarea, label")) {
        previousTitlebarTap = undefined;
        return;
      }

      if (event.pointerType === "touch") {
        touchTap = { pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, moved: false };
        event.preventDefault();
      }

      if (presentation.form !== "windowed") return;

      const rect = terminalWindow.getBoundingClientRect();
      const origin = clampPosition({ left: rect.left, top: rect.top, width: rect.width, height: rect.height });
      drag = { pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, origin, moved: false };
      titlebar.setPointerCapture(event.pointerId);
      event.preventDefault();
    }

    function pointerMove(event: PointerEvent) {
      if (touchTap?.pointerId === event.pointerId) {
        touchTap.moved ||= Math.abs(event.clientX - touchTap.startX) > titlebarTapMovement || Math.abs(event.clientY - touchTap.startY) > titlebarTapMovement;
      }

      if (!drag || drag.pointerId !== event.pointerId) return;
      const left = drag.origin.left + event.clientX - drag.startX;
      const top = drag.origin.top + event.clientY - drag.startY;
      drag.moved ||= Math.abs(left - drag.origin.left) > titlebarTapMovement || Math.abs(top - drag.origin.top) > titlebarTapMovement;
      if (!drag.moved) return;
      presentation.position = clampPosition({ ...drag.origin, left, top });
      applyWindowedLayout();
    }

    function pointerUp(event: PointerEvent) {
      const completedTouchTap = event.pointerType === "touch" && touchTap?.pointerId === event.pointerId ? touchTap : undefined;
      if (completedTouchTap) touchTap = undefined;

      if (drag?.pointerId === event.pointerId) {
        if (titlebar.hasPointerCapture(event.pointerId)) titlebar.releasePointerCapture(event.pointerId);
        drag = undefined;
      }

      if (!completedTouchTap || completedTouchTap.moved || event.type !== "pointerup") {
        if (completedTouchTap?.moved || event.type !== "pointerup") previousTitlebarTap = undefined;
        return;
      }

      const isDoubleTap = previousTitlebarTap
        && event.timeStamp - previousTitlebarTap.timestamp <= titlebarDoubleTapInterval
        && Math.hypot(event.clientX - previousTitlebarTap.x, event.clientY - previousTitlebarTap.y) <= titlebarDoubleTapDistance;

      previousTitlebarTap = isDoubleTap ? undefined : { timestamp: event.timeStamp, x: event.clientX, y: event.clientY };
      if (isDoubleTap) toggleFullscreen();
    }

    function titlebarDoubleClick(event: MouseEvent) {
      if (event.target instanceof Element && event.target.closest(".window-controls")) return;
      toggleFullscreen();
    }

    function windowClick(event: MouseEvent) {
      if (isAnimating || presentation.form !== "floating-miniature") return;
      event.preventDefault();
      event.stopPropagation();
      restoreFromMiniature();
    }

    function handleResize() {
      if (isAnimating) return;
      if (presentation.iconified) {
        applyIconifiedWithoutAnimation();
      } else if (presentation.form === "floating-miniature") {
        applyMiniatureWithoutAnimation();
      } else if (presentation.form === "windowed" && presentation.position) {
        presentation.position = clampPosition(presentation.position);
        applyWindowedLayout();
      }
    }

    closeControl.addEventListener("click", iconify);
    minimizeControl.addEventListener("click", minimize);
    fullscreenControl.addEventListener("click", toggleFullscreen);
    appIcon.addEventListener("click", restoreFromIcon);
    titlebar.addEventListener("dblclick", titlebarDoubleClick);
    titlebar.addEventListener("pointerdown", pointerDown);
    terminalWindow.addEventListener("click", windowClick, true);
    window.addEventListener("pointermove", pointerMove);
    window.addEventListener("pointerup", pointerUp);
    window.addEventListener("pointercancel", pointerUp);
    window.addEventListener("resize", handleResize);

    if (presentation.iconified) applyIconifiedWithoutAnimation();
    else if (presentation.form === "floating-miniature") applyMiniatureWithoutAnimation();
    else applyFormLayout();

    cleanupActiveWindow = () => {
      closeControl.removeEventListener("click", iconify);
      minimizeControl.removeEventListener("click", minimize);
      fullscreenControl.removeEventListener("click", toggleFullscreen);
      appIcon.removeEventListener("click", restoreFromIcon);
      titlebar.removeEventListener("dblclick", titlebarDoubleClick);
      titlebar.removeEventListener("pointerdown", pointerDown);
      terminalWindow.removeEventListener("click", windowClick, true);
      window.removeEventListener("pointermove", pointerMove);
      window.removeEventListener("pointerup", pointerUp);
      window.removeEventListener("pointercancel", pointerUp);
      window.removeEventListener("resize", handleResize);
    };
  }

  initializeTerminalWindow();
  document.addEventListener("astro:page-load", initializeTerminalWindow);
</script>

<style is:global>
  main:has(.terminal-shell) {
    width: 100%;
    height: 100dvh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .terminal-shell {
    position: relative;
    display: grid;
    width: 100vw;
    height: 100dvh;
    margin-left: calc(50% - 50vw);
    padding: clamp(1rem, 4vw, 4.5rem);
    overflow: hidden;
    background: var(--canvas);
    isolation: isolate;
  }

  .pixel-field,
  .pixel-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pixel-field {
    opacity: 0.52;
    background-image:
      radial-gradient(circle at 1px 1px, var(--effect-grid-accent) 1px, transparent 1.25px),
      radial-gradient(circle at 1px 1px, var(--effect-grid-ink) 1px, transparent 1.3px);
    background-position: 0 0, 8px 8px;
    background-size: 16px 16px;
    mask-image: radial-gradient(ellipse 90% 110% at 0% 14%, var(--effect-mask-opaque) 0 35%, transparent 73%);
  }

  .pixel-glow {
    background:
      radial-gradient(circle at 77% 55%, var(--effect-glow-accent), transparent 23rem),
      linear-gradient(115deg, transparent 38%, var(--effect-gloss-subtle) 56%, transparent 75%);
  }

  .terminal-window {
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: min(100%, 60rem);
    height: 100%;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background:
      linear-gradient(135deg, var(--effect-window-gloss), transparent 22% 76%, var(--effect-window-accent-gloss)),
      var(--effect-window-surface);
    box-shadow:
      0 2rem 6rem var(--effect-shadow-window),
      0 0 0 1px var(--effect-shadow-outline),
      inset 0 1px var(--effect-highlight-strong),
      inset 0 -1px var(--effect-shadow-inset);
    backdrop-filter: blur(1.75rem) saturate(145%);
  }

  .terminal-window.has-terminal-footer { grid-template-rows: auto minmax(0, 1fr) auto; }

  .terminal-window.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 20;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    border-right: 0;
    border-left: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media (max-width: 699px) {
    html[data-terminal-initial-form="fullscreen"] .terminal-window {
      position: fixed;
      inset: 0;
      z-index: 20;
      width: 100vw;
      height: 100dvh;
      margin: 0;
      border-right: 0;
      border-left: 0;
      border-radius: 0;
      box-shadow: none;
    }
  }

  .terminal-window.is-miniature {
    z-index: 30;
    box-shadow:
      0 1.4rem 2.9rem -1rem var(--effect-shadow-miniature),
      0 0 0 1px var(--effect-shadow-outline),
      inset 0 1px var(--effect-highlight-strong);
    cursor: pointer;
  }

  .terminal-window.is-miniature .terminal-body,
  .terminal-window.is-miniature .terminal-footer { pointer-events: none; }

  .terminal-app-icon,
  .terminal-mini-target {
    position: fixed;
    z-index: 40;
  }

  .terminal-app-icon {
    top: clamp(1rem, 4vw, 2rem);
    left: clamp(1rem, 4vw, 2rem);
    width: 3.75rem;
    height: 4.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    filter: drop-shadow(0 .85rem 1rem var(--effect-shadow-app-icon));
    opacity: 0;
    pointer-events: none;
    transform: translateY(-.45rem) scale(.88);
    transition: opacity 180ms ease, transform 220ms cubic-bezier(.32,.72,0,1), filter 160ms ease;
  }

  .terminal-app-icon.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .terminal-app-icon:hover { filter: drop-shadow(0 1rem 1.35rem var(--effect-shadow-app-icon-hover)); transform: translateY(-.16rem) scale(1.04); }
  .terminal-app-icon:active { transform: translateY(0) scale(.96); }
  .terminal-app-icon img { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; -webkit-user-drag: none; }

  .terminal-mini-target {
    bottom: clamp(1rem, 4vw, 2rem);
    left: clamp(1rem, 4vw, 2rem);
    width: clamp(10.5rem, 19vw, 13.5rem);
    height: clamp(6.75rem, 12vw, 8.6rem);
    pointer-events: none;
    visibility: hidden;
  }

  .terminal-titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.65rem;
    padding: 0 1.1rem;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--muted);
    background: linear-gradient(180deg, var(--effect-titlebar-gloss-start), var(--effect-titlebar-gloss-end));
    box-shadow: inset 0 1px var(--effect-highlight-subtle);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    user-select: none;
    touch-action: none;
  }

  .window-controls {
    display: flex;
    justify-self: start;
    width: max-content;
    gap: 0.42rem;
  }

  .window-control {
    position: relative;
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--window-control-close);
    box-shadow: inset 0 1px var(--effect-control-highlight);
    cursor: pointer;
    transition: filter 120ms ease, transform 120ms ease, opacity 120ms ease;
  }

  .window-control-icon-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 100ms ease;
  }

  .window-control-icon {
    position: absolute;
    display: block;
    max-width: none;
    pointer-events: none;
  }

  .window-control-close .window-control-icon-frame { inset: 2px; width: auto; height: auto; transform: none; }
  .window-control-close .window-control-icon { inset: 0; width: 100%; height: 100%; }
  .window-control-minimize .window-control-icon-frame { width: 0.54rem; height: 0.1rem; }
  .window-control-minimize .window-control-icon { inset: 0; width: 100%; height: 100%; }
  .window-control-fullscreen .window-control-icon-frame { width: 0.56rem; height: 0.5644rem; }

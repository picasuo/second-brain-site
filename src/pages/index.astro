---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalCommandDisplay from "../components/TerminalCommandDisplay.astro";
import { siteConfig } from "../site-config";
---

<BaseLayout title={siteConfig.home.title} ariaLabel="picasuo 个人主页" windowTitle="picasuo@second-brain:~">
    <div class="terminal-hero">
      <TerminalCommandDisplay className="terminal-prompt" command="picasuo --info" />
    </div>

    <dl class="terminal-info" aria-label="个人信息">
      <div>
        <dt>location</dt>
        <dd>杭州</dd>
      </div>
      <div>
        <dt>experience</dt>
        <dd>2021 — 至今</dd>
      </div>
      <div>
        <dt>current employer</dt>
        <dd><a href="https://www.immed.co/" target="_blank" rel="noreferrer">一目可视 <span aria-hidden="true">↗</span></a></dd>
      </div>
      <div>
        <dt>focus</dt>
        <dd>web frontend <span aria-hidden="true">│</span> electron <span aria-hidden="true">│</span> flutter</dd>
      </div>
    </dl>

    <nav class="profile-links" aria-label="个人链接">
      <TerminalCommandDisplay className="links-heading" command="ls ./links" />
      <ul>
        {siteConfig.home.links.map((link) => (
          <li>
            <a class="profile-link" data-profile-link href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
              <span class="link-marker" aria-hidden="true">&gt;</span>
              <span class="link-label">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="terminal-status"><span aria-hidden="true"></span> available for interesting work</p>
</BaseLayout>

<script>
  let clearProfileLinkListeners = () => {};

  const initializeProfileLinks = () => {
    clearProfileLinkListeners();

    const profileLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-profile-link]"));
    if (profileLinks.length === 0) return;

    const controller = new AbortController();
    clearProfileLinkListeners = () => controller.abort();
    let selectedLinkIndex = 0;

    const selectProfileLink = (nextIndex: number, moveFocus = false) => {
      selectedLinkIndex = (nextIndex + profileLinks.length) % profileLinks.length;

      profileLinks.forEach((link, index) => {
        link.classList.toggle("is-selected", index === selectedLinkIndex);
      });

      if (moveFocus) profileLinks[selectedLinkIndex]?.focus({ preventScroll: true });
    };

    selectProfileLink(0);

    profileLinks.forEach((link, index) => {
      link.addEventListener("mouseenter", () => selectProfileLink(index), { signal: controller.signal });
      link.addEventListener("focus", () => selectProfileLink(index), { signal: controller.signal });
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        selectProfileLink(selectedLinkIndex + (event.key === "ArrowDown" ? 1 : -1), true);
        return;
      }

      if (event.key === "Enter") {
        event.preventDefault();
        profileLinks[selectedLinkIndex]?.click();
      }
    }, { signal: controller.signal });
  };

  document.addEventListener("astro:page-load", initializeProfileLinks);
  initializeProfileLinks();
</script>

<style is:global>
  .terminal-hero { display: flex; gap: clamp(1rem, 3vw, 2rem); align-items: center; }

  .terminal-info { display: grid; grid-template-columns: minmax(0, 1fr); gap: .72rem; margin: clamp(1rem, 1.6vw, 1.5rem) 0 0; padding-left: 2ch; font-family: var(--font-mono); }
  .terminal-info div { display: grid; grid-template-columns: minmax(6.6rem, 9rem) minmax(0, 1fr); gap: var(--space-4); align-items: baseline; }
  .terminal-info dt { color: var(--muted); font-size: 0.78rem; }
  .terminal-info dd { margin: 0; color: var(--ink); font-size: .78rem; line-height: 1.6; }
  .terminal-info dd a { color: var(--accent-strong); text-decoration: none; }
  .terminal-info dd a:hover { text-decoration: underline; }
  .terminal-info dd [aria-hidden="true"] { color: var(--accent); }

  .profile-links { margin-top: clamp(2.25rem, 4vw, 3.5rem); }
  .links-heading { margin-bottom: .8rem; }
  .profile-links ul { display: grid; gap: .18rem; margin: 0; padding: 0; list-style: none; }
  .profile-links a { display: inline-flex; align-items: center; gap: .7rem; min-height: 2.25rem; padding: .35rem .5rem; color: var(--muted-strong); font-family: var(--font-mono); font-size: clamp(.98rem, 2vw, 1.13rem); font-weight: 650; text-decoration: none; transition: color 140ms ease, background 140ms ease; }
  .profile-links a.is-selected { color: var(--accent-strong); background: var(--accent-wash); }
  .profile-links a:focus-visible { outline: none; }
  .link-marker { width: .72rem; color: var(--accent); opacity: 0; transform: translateX(-.2rem); transition: opacity 140ms ease, transform 140ms ease; }
  .profile-links a.is-selected .link-marker { opacity: 1; transform: translateX(0); }
  .link-label { transition: text-shadow 140ms ease; }
  .profile-links a.is-selected .link-label { text-shadow: 0 0 .8rem var(--effect-link-selected-glow); }
  .terminal-status { display: flex; gap: .48rem; align-items: center; margin: clamp(2.8rem, 5vw, 4.2rem) 0 0; color: var(--muted); font: .75rem var(--font-mono); }
  .terminal-status span { width: .48rem; height: .48rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 .75rem var(--effect-status-glow); animation: status-pulse 2.2s ease-in-out infinite; }

  @keyframes status-pulse { 50% { opacity: .4; box-shadow: 0 0 .2rem var(--effect-status-glow-pulse); } }

  @media (max-width: 43rem) {
    .terminal-info { gap: .72rem; }
    .terminal-info div { grid-template-columns: 6.15rem minmax(0, 1fr); gap: .55rem; }
    .profile-links { margin-top: 3.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-status span { animation: none; }
    .profile-links a, .link-marker, .link-label { transition: none; }
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalCommandDisplay from "../../components/TerminalCommandDisplay.astro";
import { publishedNotes } from "../../generated/published-notes";
import TerminalShell from "../../layouts/TerminalShell.astro";

export function getStaticPaths() {
  return publishedNotes.map((note) => ({
    params: { slug: note.noteUrl.slice("/notes/".length, -1) },
    props: { note },
  }));
}

const { note } = Astro.props;
const tocItems = note.tableOfContents.map((item, index) => {
  const sectionIndex = note.tableOfContents.slice(0, index + 1).filter((candidate) => candidate.depth === 2).length;
  const isLastTopLevel = item.depth === 2 && note.tableOfContents.slice(index + 1).every((candidate) => candidate.depth !== 2);
  return {
    ...item,
    branch: isLastTopLevel ? "└─" : "├─",
    number: String(sectionIndex).padStart(2, "0"),
  };
});
---

<BaseLayout title={note.title}>
  <TerminalShell ariaLabel={`阅读 ${note.title}`} windowTitle={note.filename}>
    <article class="terminal-note">
      <TerminalCommandDisplay command={`view ~/notes/${note.filename}`} />
      <header class="note-header">
        <h1>{note.title}</h1>
        <dl class="note-metadata-kv" aria-label="Published Note metadata">
          <div>
            <dt>date</dt>
            <dd><time datetime={note.date}>{note.date}</time></dd>
          </div>
          <div>
            <dt>tags</dt>
            <dd>{note.tags.length > 0 ? note.tags.map((tag) => `#${tag}`).join(" ") : "—"}</dd>
          </div>
        </dl>
      </header>

      {note.tableOfContents.length > 0 && (
        <details class="narrow-table-of-contents">
          <summary>Table of Contents</summary>
          <ol>
            {tocItems.map((item) => (
              <li class={`depth-${item.depth}`}>
                <a href={`#${item.id}`} data-toc-link={item.depth === 2 ? item.id : undefined}>
                  {item.depth === 2 ? <><span class="toc-branch" aria-hidden="true">{item.branch}</span> <span class="toc-number">{item.number}</span> </> : null}
                  {item.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <div class="note-layout">
        {note.tableOfContents.length > 0 && (
          <nav class="wide-table-of-contents" aria-label="目录">
            <strong><span aria-hidden="true">$</span> tree --toc</strong>
            <ol>
              {tocItems.map((item) => (
                <li class={`depth-${item.depth}`}>
                  <a href={`#${item.id}`} data-toc-link={item.depth === 2 ? item.id : undefined}>
                    {item.depth === 2 ? <><span class="toc-branch" aria-hidden="true">{item.branch}</span> <span class="toc-number">{item.number}</span> </> : null}
                    {item.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="note-body" set:html={note.renderedContent} />
      </div>
    </article>

    <a slot="footer" class="terminal-footer-link" href="/notes/">← Back to notes</a>
  </TerminalShell>
</BaseLayout>

<style is:global>
  .terminal-note { max-width: 70rem; }
  .terminal-note > .terminal-command { margin-bottom: clamp(1.6rem, 3vw, 2.6rem); }
  .terminal-note .note-header { max-width: 50rem; margin-bottom: 2.5rem; padding-bottom: 1.6rem; border-bottom: 1px solid var(--rule-soft); }
  .terminal-note h1 { margin: 0; color: var(--ink); font-family: var(--font-mono); font-size: clamp(1.25rem, 3vw, 1.7rem); font-weight: 700; line-height: 1.4; }
  .note-metadata-kv { display: flex; flex-wrap: wrap; gap: .55rem 1.4rem; margin: 1.2rem 0 0; color: var(--muted); font-family: var(--font-mono); font-size: .78rem; line-height: 1.6; }
  .note-metadata-kv div { display: flex; gap: .55rem; align-items: baseline; }
  .note-metadata-kv dt { color: var(--muted-faint); }
  .note-metadata-kv dd { margin: 0; color: var(--muted-strong); }
  .note-metadata-kv time { color: var(--ink); }

  .terminal-note .note-layout { display: block; grid-template-columns: none; grid-template-areas: none; gap: 0; }
  .terminal-note .note-body { grid-area: auto; }
  .wide-table-of-contents { display: none; }
  .narrow-table-of-contents { margin: 0 0 2.5rem; border: 1px solid var(--rule-soft); border-radius: .5rem; color: var(--muted); font-size: .82rem; line-height: 1.85; overflow: hidden; }
  .narrow-table-of-contents summary { padding: .75rem .9rem; color: var(--muted-strong); background: var(--surface-soft); cursor: pointer; font: 650 .82rem var(--font-mono); }
  .narrow-table-of-contents ol { display: grid; gap: .2rem; margin: 0; padding: .55rem .9rem .9rem; list-style: none; }
  .narrow-table-of-contents .depth-3 { padding-left: 1rem; }
  .narrow-table-of-contents a { color: var(--muted); text-decoration: none; }
  .narrow-table-of-contents .depth-3 a { color: var(--muted-faint); }
  .narrow-table-of-contents a:hover { color: var(--accent-strong); }
  .toc-branch, .toc-number { color: var(--muted-faint); }

  @media (min-width: 1200px) {
    .terminal-note .note-layout { display: grid; grid-template-columns: minmax(12.5rem, 16rem) minmax(0, 50rem); grid-template-areas: none; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .wide-table-of-contents { position: sticky; top: 0; display: block; padding: .15rem 1rem .2rem 0; color: var(--muted); font-size: .82rem; line-height: 1.9; }
    .wide-table-of-contents > strong { display: block; margin-bottom: 1rem; color: var(--ink); font: 700 .82rem var(--font-mono); }
    .wide-table-of-contents > strong span { color: var(--accent); }
    .wide-table-of-contents ol { display: grid; gap: .28rem; margin: 0; padding: 0; list-style: none; }
    .wide-table-of-contents .depth-3 { padding-left: 1.85rem; }
    .wide-table-of-contents a { position: relative; display: block; padding: .08rem 0 .08rem .62rem; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; transition: color 140ms ease, border-color 140ms ease; }
    .wide-table-of-contents .depth-3 a { color: var(--muted-faint); }
    .wide-table-of-contents a:hover { color: var(--ink); }
    .wide-table-of-contents a.is-active { border-left-color: var(--accent); color: var(--accent-strong); }
    .wide-table-of-contents a.is-active .toc-branch, .wide-table-of-contents a.is-active .toc-number { color: var(--accent-strong); }
    .narrow-table-of-contents { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-footer-link { transition: none; }
  }
</style>

<script>
  const wideTocMedia = window.matchMedia("(min-width: 1200px)");
  const topLevelHeadings = Array.from(document.querySelectorAll<HTMLElement>(".note-body h2[id]"));
  const wideTocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".wide-table-of-contents [data-toc-link]"));
  let tocObserver: IntersectionObserver | null = null;

  const setActiveTocLink = (id: string | null) => {
    for (const link of wideTocLinks) {
      link.classList.toggle("is-active", id !== null && link.dataset.tocLink === id);
    }
  };

  const updateTocSpy = () => {
    tocObserver?.disconnect();
    tocObserver = null;
    setActiveTocLink(null);

    if (!wideTocMedia.matches || topLevelHeadings.length === 0) return;
    setActiveTocLink(topLevelHeadings[0]?.id ?? null);

    tocObserver = new IntersectionObserver((entries) => {
      const visibleHeading = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)
        .at(0)?.target as HTMLElement | undefined;
      if (visibleHeading) setActiveTocLink(visibleHeading.id);
    }, { root: document.querySelector(".terminal-body"), rootMargin: "0px 0px -72% 0px", threshold: 0 });

    for (const heading of topLevelHeadings) tocObserver.observe(heading);
  };

  updateTocSpy();
  wideTocMedia.addEventListener("change", updateTocSpy);
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalCommandDisplay from "../../components/TerminalCommandDisplay.astro";
import { publishedNotes } from "../../generated/published-notes";

export function getStaticPaths() {
  return publishedNotes.map((note) => ({
    params: { slug: note.noteUrl.slice("/notes/".length, -1) },
    props: { note },
  }));
}

const { note } = Astro.props;
const tocItems = note.tableOfContents.map((item, index) => {
  const sectionIndex = note.tableOfContents.slice(0, index + 1).filter((candidate) => candidate.depth === 2).length;
  const isLastTopLevel = item.depth === 2 && note.tableOfContents.slice(index + 1).every((candidate) => candidate.depth !== 2);
  return {
    ...item,
    branch: isLastTopLevel ? "└─" : "├─",
    number: String(sectionIndex).padStart(2, "0"),
  };
});
---

<BaseLayout title={note.title} ariaLabel={`阅读 ${note.title}`} windowTitle={note.filename}>
    <article class="terminal-note">
      <TerminalCommandDisplay command={`view ~/notes/${note.filename}`} />
      <header class="note-header">
        <h1>{note.title}</h1>
        <dl class="note-metadata-kv" aria-label="Published Note metadata">
          <div>
            <dt>date</dt>
            <dd><time datetime={note.date}>{note.date}</time></dd>
          </div>
          <div>
            <dt>tags</dt>
            <dd>{note.tags.length > 0 ? note.tags.map((tag) => `#${tag}`).join(" ") : "—"}</dd>
          </div>
        </dl>
      </header>

      {note.tableOfContents.length > 0 && (
        <details class="toc-mobile">
          <summary>$ tree --toc</summary>
          <nav aria-label="目录">
            {tocItems.map((item) => (
              <a class={item.depth === 3 ? "sub" : undefined} href={`#${item.id}`} data-toc-link={item.depth === 2 ? item.id : undefined}>
                {item.depth === 2 ? <><span class="toc-branch" aria-hidden="true">{item.branch}</span> <span class="toc-number">{item.number}</span> </> : null}
                {item.depth === 3 ? "\u00a0\u00a0" : null}
                {item.text}
              </a>
            ))}
          </nav>
        </details>
      )}

      <div class="note-layout">
        {note.tableOfContents.length > 0 && (
          <nav class="wide-table-of-contents" aria-label="目录">
            <strong><span aria-hidden="true">$</span> tree --toc</strong>
            <ol>
              {tocItems.map((item) => (
                <li class={`depth-${item.depth}`}>
                  <a href={`#${item.id}`} data-toc-link={item.depth === 2 ? item.id : undefined}>
                    {item.depth === 2 ? <><span class="toc-branch" aria-hidden="true">{item.branch}</span> <span class="toc-number">{item.number}</span> </> : null}
                    {item.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="note-body" set:html={note.renderedContent} />
      </div>
    </article>

  <a slot="footer" class="terminal-footer-link" href="/notes/">← Back to notes</a>
</BaseLayout>

<style is:global>
  .note-body { grid-area: content; min-width: 0; max-width: 66ch; color: var(--ink); font-family: var(--font-mono); font-size: clamp(0.94rem, 1.45vw, 1rem); line-height: 1.9; }
  .note-body > :first-child { margin-top: 0; }
  .note-body > :last-child { margin-bottom: 0; }
  .note-body p { margin: 0 0 1.15rem; }
  .note-body:has(.doc-section) > :not(.doc-section) { margin-left: 2.375rem; }
  .note-body ul, .note-body ol { margin: 1.1rem 0 1.25rem; padding-left: 1.4rem; }
  .note-body li + li { margin-top: 0.35rem; }
  .note-body h2, .note-body h3 { scroll-margin-top: 1.5rem; line-height: 1.35; }
  .note-body h2 { margin: 0 0 1.15rem; color: var(--ink); font-size: 1.1rem; font-weight: 700; }
  .note-body h3 { margin: 2.1rem 0 0.8rem; color: var(--accent-strong); font-size: 0.94rem; font-weight: 650; }
  .note-body .doc-section { position: relative; margin: 0 0 2.375rem; padding-left: 2.375rem; border-left: 1px solid var(--rule-soft); }
  .note-body .doc-section:last-child { margin-bottom: 0; border-left-color: transparent; }
  .note-body .doc-section .sec-no,
  .note-body .doc-section[data-section-number]::before {
    position: absolute;
    top: 0.125rem;
    left: -0.8125rem;
    padding: 0.125rem 0.25rem;
    color: var(--muted-faint);
    background: var(--surface);
    font-size: 0.6875rem;
    line-height: normal;
  }
  .note-body .doc-section[data-section-number]::before { content: attr(data-section-number); }
  .note-body blockquote { margin: 1.65rem 0; padding: 0.85rem 1rem; border-left: 2px solid var(--accent); border-radius: 0 0.45rem 0.45rem 0; color: var(--muted-strong); background: var(--accent-wash); font-size: 0.92em; }
  .note-body blockquote > :last-child { margin-bottom: 0; }
  .note-body hr { height: 1px; margin: 2.5rem 0; border: 0; background: var(--rule-soft); }
  .note-body code { padding: 0.12em 0.34em; border: 1px solid var(--rule-soft); border-radius: 0.22rem; color: var(--accent-strong); background: var(--surface-soft); font-family: var(--font-mono); font-size: 0.86em; }
  .note-body pre { overflow-x: auto; padding: 1rem 1.15rem; border: 1px solid var(--rule-soft); border-radius: 0.5rem; color: var(--ink); background: var(--surface-soft); line-height: 1.65; }
  .note-body pre code { padding: 0; background: transparent; color: inherit; }
  .note-body table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-family: var(--font-mono); font-size: 0.84em; }
  .note-body th, .note-body td { padding: 0.65rem 0.75rem; border: 1px solid var(--rule); text-align: left; }
  .note-body th { color: var(--accent-strong); background: var(--accent-wash); }
  .note-body img { display: block; max-width: 100%; height: auto; }

  .terminal-note { max-width: 70rem; }
  .terminal-note > .terminal-command { margin-bottom: clamp(1.6rem, 3vw, 2.6rem); }
  .terminal-note .note-header { max-width: 50rem; margin-bottom: 2.5rem; padding-bottom: 1.6rem; border-bottom: 1px solid var(--rule-soft); }
  .terminal-note h1 { margin: 0; color: var(--ink); font-family: var(--font-mono); font-size: clamp(1.25rem, 3vw, 1.7rem); font-weight: 700; line-height: 1.4; }
  .note-metadata-kv { display: flex; flex-wrap: wrap; gap: .55rem 1.4rem; margin: 1.2rem 0 0; color: var(--muted); font-family: var(--font-mono); font-size: .78rem; line-height: 1.6; }
  .note-metadata-kv div { display: flex; gap: .55rem; align-items: baseline; }
  .note-metadata-kv dt { color: var(--muted-faint); }
  .note-metadata-kv dd { margin: 0; color: var(--muted-strong); }
  .note-metadata-kv time { color: var(--ink); }

  .terminal-note .note-layout { display: block; grid-template-columns: none; grid-template-areas: none; gap: 0; }
  .terminal-note .note-body { grid-area: auto; }
  .wide-table-of-contents { display: none; }
  .toc-mobile { display: block; margin: 26px 0 32px; border: 1px solid var(--rule-soft); border-radius: var(--radius-md); color: var(--muted); font-family: var(--font-mono); overflow: hidden; }
  .toc-mobile summary { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; color: var(--muted); background: var(--surface-soft); cursor: pointer; font-family: inherit; font-size: 13px; list-style: none; }
  .toc-mobile summary::-webkit-details-marker { display: none; }
  .toc-mobile summary::after { color: var(--muted-faint); content: "▾"; transition: transform .15s ease; }
  .toc-mobile[open] summary::after { transform: rotate(180deg); }
  .toc-mobile nav { display: flex; flex-direction: column; padding: 6px 14px 14px; font-family: inherit; font-size: 13px; line-height: 2; }
  .toc-mobile a { color: inherit; text-decoration: none; }
  .toc-mobile a.sub { padding-left: 16px; color: var(--muted-faint); font-size: 12.5px; }
  .toc-branch, .toc-number { color: var(--muted-faint); }

  @media (min-width: 700px) {
    .terminal-note .note-layout { display: grid; grid-template-columns: minmax(12.5rem, 16rem) minmax(0, 50rem); grid-template-areas: none; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .wide-table-of-contents { position: sticky; top: 0; display: block; padding: .15rem 1rem .2rem 0; color: var(--muted); font-size: .82rem; line-height: 1.9; }
    .wide-table-of-contents > strong { display: block; margin-bottom: 1rem; color: var(--ink); font: 700 .82rem var(--font-mono); }
    .wide-table-of-contents > strong span { color: var(--accent); }
    .wide-table-of-contents ol { display: grid; gap: .28rem; margin: 0; padding: 0; list-style: none; }
    .wide-table-of-contents .depth-3 { padding-left: 1.85rem; }
    .wide-table-of-contents a { position: relative; display: block; padding: .08rem 0 .08rem .62rem; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; transition: color 140ms ease, border-color 140ms ease; }
    .wide-table-of-contents .depth-3 a { color: var(--muted-faint); }
    .wide-table-of-contents a:hover { color: var(--ink); }
    .wide-table-of-contents a.is-active { border-left-color: var(--accent); color: var(--accent-strong); }
    .wide-table-of-contents a.is-active .toc-branch, .wide-table-of-contents a.is-active .toc-number { color: var(--accent-strong); }
    .toc-mobile { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-footer-link { transition: none; }
  }
</style>

<script>
  let clearNoteTocListeners = () => {};

  const initializeNoteToc = () => {
    clearNoteTocListeners();

    const wideTocMedia = window.matchMedia("(min-width: 700px)");
    const topLevelHeadings = Array.from(document.querySelectorAll<HTMLElement>(".note-body h2[id]"));
    const wideTocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".wide-table-of-contents [data-toc-link]"));
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".wide-table-of-contents a[href^='#'], .toc-mobile a[href^='#']"));
    if (topLevelHeadings.length === 0 || wideTocLinks.length === 0) return;

    const controller = new AbortController();
    let tocObserver: IntersectionObserver | null = null;
    clearNoteTocListeners = () => {
      controller.abort();
      tocObserver?.disconnect();
    };

    const setActiveTocLink = (id: string | null) => {
      for (const link of wideTocLinks) {
        link.classList.toggle("is-active", id !== null && link.dataset.tocLink === id);
      }
    };

    const updateTocSpy = () => {
      tocObserver?.disconnect();
      tocObserver = null;
      setActiveTocLink(null);

      if (!wideTocMedia.matches) return;
      setActiveTocLink(topLevelHeadings[0]?.id ?? null);

      tocObserver = new IntersectionObserver((entries) => {
        const visibleHeading = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)
          .at(0)?.target as HTMLElement | undefined;
        if (visibleHeading) setActiveTocLink(visibleHeading.id);
      }, { root: document.querySelector(".terminal-body"), rootMargin: "0px 0px -72% 0px", threshold: 0 });

      for (const heading of topLevelHeadings) tocObserver.observe(heading);
    };

    for (const link of tocLinks) {
      link.addEventListener("click", (event) => {
        const targetId = link.getAttribute("href")?.slice(1);
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "start",
        });
        window.history.pushState(null, "", `#${targetId}`);
      }, { signal: controller.signal });
    }

    updateTocSpy();
    wideTocMedia.addEventListener("change", updateTocSpy, { signal: controller.signal });
  };

  document.addEventListener("astro:page-load", initializeNoteToc);
  initializeNoteToc();
</script>

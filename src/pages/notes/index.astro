---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalCommandDisplay from "../../components/TerminalCommandDisplay.astro";
import TerminalShell from "../../layouts/TerminalShell.astro";
import { publishedNotes } from "../../generated/published-notes";

const tags = [...new Set(publishedNotes.flatMap((note) => note.tags))]
  .sort((left, right) => left.localeCompare(right, "zh-CN"));
const latest = publishedNotes.at(0)?.date ?? "—";
const hasPublishedNotes = publishedNotes.length > 0;
---

<BaseLayout title="笔记">
  <TerminalShell ariaLabel="Notes Index" windowTitle="picasuo@github-page:~/notes">
    <section class="notes-index" aria-labelledby="notes-title">
      <TerminalCommandDisplay command="ls ~/notes" />
      <h1 id="notes-title">Notes</h1>
      <p class="notes-summary" aria-label="Published Note summary">
        <span>total {publishedNotes.length} 篇</span>
        <span>latest {latest}</span>
      </p>

      {hasPublishedNotes ? (
        <>
          <div class="notes-filters" aria-label="Filter published notes">
            <div class="tag-filters" aria-label="Filter by tag">
              <button type="button" class="tag-filter" data-tag-filter data-tag="" aria-pressed="true">--all</button>
              {tags.map((tag) => <button type="button" class="tag-filter" data-tag-filter data-tag={tag} aria-pressed="false">{tag}</button>)}
            </div>
            <label class="notes-search">
              <span>search</span>
              <input data-notes-search type="search" autocomplete="off" placeholder="title" />
            </label>
          </div>

          <div class="notes-table" data-notes-table>
            <div class="notes-table-header" aria-hidden="true">
              <span>DATE</span><span>NAME</span><span>TAGS</span>
            </div>
            <ol class="note-list">
              {publishedNotes.map((note) => (
                <li>
                  <a
                    class="note-row"
                    data-note-row
                    data-note-title={note.title}
                    data-note-tags={JSON.stringify(note.tags)}
                    href={note.noteUrl}
                    aria-label={`Open ${note.title}`}
                  >
                    <time datetime={note.date}>{note.date}</time>
                    <span class="note-row-title">{note.title}</span>
                    <span class="note-row-tags">{note.tags.length > 0 ? note.tags.join(" · ") : "—"}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <p class="notes-no-match" data-no-match hidden><span aria-hidden="true">$</span> grep: no matching notes</p>
        </>
      ) : (
        <p class="notes-empty"><span aria-hidden="true">$</span> notes: no published notes</p>
      )}
    </section>

    <a slot="footer" class="terminal-footer-link" href="/">← Back to home</a>
  </TerminalShell>
</BaseLayout>

{hasPublishedNotes && <script>
  const tagFilters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"));
  const search = document.querySelector<HTMLInputElement>("[data-notes-search]");
  const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-note-row]"));
  const table = document.querySelector<HTMLElement>("[data-notes-table]");
  const noMatch = document.querySelector<HTMLElement>("[data-no-match]");
  let selectedTag = "";

  const normalize = (value: string) => value.normalize("NFKC").trim().toLocaleLowerCase();

  const applyFilters = () => {
    const query = normalize(search?.value ?? "");
    let visibleCount = 0;

    for (const row of rows) {
      const titleMatches = normalize(row.dataset.noteTitle ?? "").includes(query);
      const tags = JSON.parse(row.dataset.noteTags ?? "[]") as string[];
      const tagMatches = selectedTag === "" || tags.includes(selectedTag);
      const visible = titleMatches && tagMatches;
      row.closest("li")?.toggleAttribute("hidden", !visible);
      if (visible) visibleCount += 1;
    }

    table?.toggleAttribute("hidden", visibleCount === 0);
    noMatch?.toggleAttribute("hidden", visibleCount !== 0);
  };

  for (const filter of tagFilters) {
    filter.addEventListener("click", () => {
      selectedTag = filter.dataset.tag ?? "";
      tagFilters.forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
      applyFilters();
    });
  }

  search?.addEventListener("input", applyFilters);
</script>}

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotesIndexFilterPrompt from "../../components/NotesIndexFilterPrompt.astro";
import TerminalCommandDisplay from "../../components/TerminalCommandDisplay.astro";
import TerminalShell from "../../layouts/TerminalShell.astro";
import { publishedNotes } from "../../generated/published-notes";

const tags = [...new Set(publishedNotes.flatMap((note) => note.tags))]
  .sort((left, right) => left.localeCompare(right, "zh-CN"));
const latest = publishedNotes.at(0)?.date ?? "—";
const hasPublishedNotes = publishedNotes.length > 0;
---

<BaseLayout title="笔记">
  <TerminalShell ariaLabel="Notes Index" windowTitle="picasuo@second-brain:~/notes">
    <section class="notes-index" aria-label="Notes Index">
      <TerminalCommandDisplay command="notes --info" />
      <dl class="notes-summary" aria-label="Published Note summary">
        <div>
          <dt>total</dt>
          <dd>{publishedNotes.length}</dd>
        </div>
        <div>
          <dt>latest</dt>
          <dd>{latest}</dd>
        </div>
      </dl>

      {hasPublishedNotes ? (
        <>
          <NotesIndexFilterPrompt tags={tags} />

          <div class="notes-table" data-notes-table>
            <div class="notes-table-header" aria-hidden="true">
              <span>DATE</span><span>NAME</span><span>TAGS</span>
            </div>
            <ol class="note-list">
              {publishedNotes.map((note) => (
                <li>
                  <a
                    class="note-row"
                    data-note-row
                    data-note-title={note.title}
                    data-note-tags={JSON.stringify(note.tags)}
                    href={note.noteUrl}
                    aria-label={`Open ${note.title}`}
                  >
                    <time datetime={note.date}>{note.date}</time>
                    <span class="note-row-title">{note.title}</span>
                    <span class="note-row-tags">{note.tags.length > 0 ? note.tags.map((tag) => `#${tag}`).join(" ") : "—"}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <p class="notes-no-match" data-no-match hidden><span aria-hidden="true">$</span> grep: no matching notes</p>
        </>
      ) : (
        <p class="notes-empty"><span aria-hidden="true">$</span> notes: no published notes</p>
      )}
    </section>

    <a slot="footer" class="terminal-footer-link" href="/">← Back to home</a>
  </TerminalShell>
</BaseLayout>
